---
import Base from '../layouts/Base.astro';
import SectionLabel from '../components/SectionLabel.astro';
import TallyEmbed from '../components/TallyEmbed.astro';
import Placeholder from '../components/Placeholder.astro';
import FAQ from '../components/FAQ.astro';
import LogoStrip from '../components/LogoStrip.astro';

const includes = [
  { t: 'Buyer prompts', b: 'The questions your buyers ask AI assistants about your category.' },
  { t: 'Citation check', b: 'Whether ChatGPT, Perplexity and AI Overviews mention you, and in what position.' },
  { t: 'Competitor view', b: 'How you compare with the two competitors you name.' },
  { t: 'First fixes', b: 'Three changes most likely to get you cited.' },
];
const rows = [
  { prompt: 'best contractor payroll tool for startups', you: '—', a: '1', b: '3' },
  { prompt: 'how to pay contractors in india from the us', you: '4', a: '1', b: '—' },
  { prompt: 'eor vs contractor for first international hire', you: '—', a: '2', b: '1' },
];
const faq = [
  { q: 'Is it really free?', a: 'Placeholder answer.' },
  { q: 'What do you need from me?', a: 'Your work email, company website and two competitors. That’s it.' },
  { q: 'When do I get it?', a: 'Your report arrives within 48 hours.' },
];
const reportLd = {
  '@context': 'https://schema.org', '@type': 'Service', name: 'Free AI Visibility Report', serviceType: 'AI search visibility analysis',
  provider: { '@id': 'https://artemi.in/#organization' }, areaServed: 'Worldwide',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, url: 'https://artemi.in/ai-visibility-report',
};
---
<Base
  title="Free AI Visibility Report for B2B SaaS"
  description="See whether ChatGPT, Perplexity and Google AI Overviews recommend your brand or your competitors. Free report, delivered within 48 hours."
  jsonLd={[reportLd]}
>
  <section class="rh">
    <div class="container grid">
      <div class="c-6 rh-copy">
        <p class="mono muted">Free report · Delivered within 48 hours</p>
        <h1>Does AI recommend you, or your competitors?</h1>
        <p class="lead">Tell us your website and two competitors. We’ll run your buyers’ prompts across the major AI engines and send you what we find.</p>
        <ul class="incl">
          {includes.map((i, n) => (<li><span class="mono muted">0{n + 1}</span><div><strong>{i.t}</strong><p class="muted">{i.b}</p></div></li>))}
        </ul>
      </div>
      <div class="c-5 s-8 rh-form" id="request">
        <h2 class="form-title">Request your report</h2>
        <TallyEmbed />
        <p class="mono muted privacy">We use your details only to prepare the report. <a class="link" href="/privacy">Privacy</a></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionLabel num="01" label="Sample" />
      <div class="grid">
        <h2 class="c-6">What the report shows.</h2>
        <p class="c-5 s-8 lead muted">Each row is a real buyer prompt. Numbers are the position at which each brand is cited in the AI answer.</p>
      </div>
      <figure class="sample">
        <div class="sample-bar mono"><span>Citation position by prompt</span><Placeholder note="sample report table">Sample data</Placeholder></div>
        <div class="table-wrap">
          <table>
            <caption class="sr-only">Sample citation positions for you and two competitors</caption>
            <thead><tr><th scope="col" class="mono">Buyer prompt</th><th scope="col" class="mono">You</th><th scope="col" class="mono">Competitor A</th><th scope="col" class="mono">Competitor B</th></tr></thead>
            <tbody>
              {rows.map((r) => (<tr><td class="mono p">{r.prompt}</td><td class="num">{r.you === '—' ? <span class="miss">Not cited</span> : r.you}</td><td class="num">{r.a}</td><td class="num">{r.b}</td></tr>))}
            </tbody>
          </table>
        </div>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container grid">
      <div class="c-4"><SectionLabel num="02" label="FAQ" /><h2>Questions</h2></div>
      <div class="c-8"><FAQ items={faq} /></div>
    </div>
  </section>
  <div class="container lstrip"><LogoStrip /></div>
</Base>
<style>
  .rh { padding: clamp(40px, 6vw, 88px) 0 var(--section); }
  .rh-copy > * + * { margin-top: 24px; }
  .incl { margin-top: 40px !important; border-top: 1px solid var(--ink); }
  .incl li { display: grid; grid-template-columns: 40px 1fr; gap: 8px; padding: 16px 0; border-bottom: 1px solid var(--hairline); }
  .incl p { margin: 4px 0 0; font-size: var(--fs-small); }
  .rh-form { margin-top: 40px; padding: 24px; border: 1px solid var(--ink); background: var(--paper-2); align-self: start; }
  @media (min-width: 900px) { .rh-form { margin-top: 0; position: sticky; top: 92px; } }
  .form-title { font-size: var(--fs-h3); margin-bottom: 20px; }
  .privacy { margin: 16px 0 0; text-transform: none; letter-spacing: 0; }
  .sample { margin: 48px 0 0; border: 1px solid var(--ink); background: #fff; }
  .sample-bar { display: flex; justify-content: space-between; gap: 12px; padding: 10px 16px; border-bottom: 1px solid var(--hairline); }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; min-width: 560px; }
  th, td { text-align: left; padding: 14px 16px; border-bottom: 1px solid var(--hairline); }
  th { color: var(--graphite); font-weight: 500; }
  td.p { text-transform: none; letter-spacing: 0; font-size: 0.8125rem; }
  td.num { font-weight: 600; font-size: 1.125rem; }
  td .miss { font-size: 0.875rem; text-decoration: underline 2px var(--redline); text-underline-offset: 4px; }
  .lstrip { padding-bottom: var(--section); }
</style>
