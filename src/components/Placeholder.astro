---
// Marks placeholder content. Always carries a hidden data-placeholder marker that
// scripts/check-placeholders.mjs uses to block production builds.
// Visible label + highlight only when showPlaceholderMarkers is true (src/config/site.ts).
import { showPlaceholderMarkers } from '../config/site';
interface Props { note?: string; block?: boolean; }
const { note = 'placeholder', block = false } = Astro.props;
const Tag = block ? 'div' : showPlaceholderMarkers ? 'mark' : 'span';
---
{showPlaceholderMarkers
  ? <Tag class:list={['ph', { 'ph-block': block }]} data-placeholder={note}><span class="ph-tag">[PLACEHOLDER]</span><slot /></Tag>
  : <Tag data-placeholder={note}><slot /></Tag>}
