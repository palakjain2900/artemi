---
import Placeholder from './Placeholder.astro';
export interface Tier { name: string; price: string; cadence: string; for: string; includes: string[]; cta: { label: string; href: string }; featured?: boolean; }
interface Props { tiers: Tier[]; }
const { tiers } = Astro.props;
---
<div class="pt">
  {tiers.map((t) => (
    <article class:list={['tier', { featured: t.featured }]}>
      <header>
        {t.featured && <p class="mono tier-flag">Most chosen</p>}
        <h3>{t.name}</h3>
        <p class="muted tier-for">{t.for}</p>
      </header>
      <p class="tier-price num"><Placeholder note={`price: ${t.name}`}>{t.price}</Placeholder><span class="mono muted"> {t.cadence}</span></p>
      <ul>{t.includes.map((i) => <li>{i}</li>)}</ul>
      <a class:list={['btn', t.featured ? 'btn--primary' : 'btn--ghost']} href={t.cta.href}
         data-track={t.cta.href === '/book' ? 'book_call_click' : 'cta_click'} data-track-label={t.cta.label} data-track-location={`pricing:${t.name}`}>{t.cta.label}</a>
    </article>
  ))}
</div>
<style>
  .pt { display: grid; gap: var(--gap); }
  @media (min-width: 900px) { .pt { grid-template-columns: repeat(3, 1fr); } }
  .tier { display: flex; flex-direction: column; gap: 20px; padding: 24px; border: 1px solid var(--hairline); }
  .tier.featured { border-color: var(--ink); box-shadow: inset 0 0 0 1px var(--ink); }
  .tier-flag { margin: 0 0 8px; }
  .tier h3 { margin-bottom: 8px; }
  .tier-for { margin: 0; font-size: var(--fs-small); }
  .tier-price { font-size: clamp(2rem, 3.5vw, 2.75rem); font-weight: 600; margin: 0; }
  .tier ul { flex: 1; }
  .tier li { padding: 10px 0; border-top: 1px solid var(--hairline); font-size: var(--fs-small); }
</style>
