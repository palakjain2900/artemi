---
import { integrations, isSet } from '../config/site';
const url = integrations.calendlyUrl;
const ready = isSet(url);
const src = ready ? `${url}${url.includes('?') ? '&' : '?'}hide_gdpr_banner=1&background_color=f4f1ea&text_color=111110&primary_color=111110` : '';
---
{ready ? (
  <div class="cal">
    <div class="calendly-inline-widget" data-url={src} style="min-width:320px;height:720px;"></div>
    <script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script>
  </div>
) : (
  <div class="cal-mock" data-placeholder="Calendly URL not set (design stand-in calendar)">
    <!-- Design stand-in until the Calendly link is set. -->
    <div class="cm-head">
      <p class="mono muted">Artemi</p>
      <p class="cm-title">30-minute intro call</p>
      <p class="mono muted">30 min · Video call</p>
    </div>
    <div class="cm-body">
      <p class="cm-month">Select a day</p>
      <div class="cm-grid" aria-hidden="true">
        {['M','T','W','T','F','S','S'].map((d) => <span class="mono muted">{d}</span>)}
        {Array.from({ length: 30 }, (_, i) => i + 1).map((n) => <span class:list={['cm-day', { on: [3,4,5,10,11,12,17,18,19,24,25,26].includes(n), sel: n === 11 }]}>{n}</span>)}
      </div>
      <div class="cm-slots" aria-hidden="true">
        {['10:00', '11:30', '14:00', '15:30', '17:00'].map((t) => <span class="cm-slot">{t}</span>)}
      </div>
    </div>
  </div>
)}
<script>
  window.addEventListener('message', (e) => {
    if (e.origin !== 'https://calendly.com') return;
    if (e.data?.event === 'calendly.event_scheduled') (window as any).artemiTrack?.('book_call_scheduled', {});
  });
</script>
<style>
  .cal { min-height: 720px; border: 1px solid var(--hairline); }
  .cal-mock { border: 1px solid var(--ink); background: #fff; }
  .cm-head { padding: 24px; border-bottom: 1px solid var(--hairline); }
  .cm-head p { margin: 0; }
  .cm-title { font-size: var(--fs-h3); font-weight: 600; letter-spacing: -0.02em; margin: 6px 0 !important; }
  .cm-body { padding: 24px; display: grid; gap: 24px; }
  @media (min-width: 700px) { .cm-body { grid-template-columns: 3fr 2fr; } .cm-month { grid-column: 1 / -1; } }
  .cm-month { margin: 0; font-weight: 600; }
  .cm-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px; text-align: center; }
  .cm-day { display: grid; place-items: center; aspect-ratio: 1; border-radius: 50%; color: var(--graphite); font-size: 0.9375rem; }
  .cm-day.on { color: var(--ink); background: var(--paper); font-weight: 600; }
  .cm-day.sel { background: var(--ink); color: var(--paper); }
  .cm-slots { display: grid; gap: 8px; align-content: start; }
  .cm-slot { display: block; padding: 12px; text-align: center; border: 1px solid var(--ink); font-weight: 600; }
</style>
