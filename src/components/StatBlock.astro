---
// Big number with label. Counts up once when scrolled into view.
import Placeholder from './Placeholder.astro';
interface Props { value: number; prefix?: string; suffix?: string; decimals?: number; label: string; source?: string; placeholder?: boolean; highlight?: boolean; }
const { value, prefix = '', suffix = '', decimals = 0, label, source, placeholder = true, highlight = false } = Astro.props;
const display = value.toLocaleString('en-US', { minimumFractionDigits: decimals, maximumFractionDigits: decimals });
---
<div class="stat">
  <p class:list={['stat-value num', { key: highlight }]}>
    {placeholder ? (
      <Placeholder note={`stat: ${label}`}>{prefix}<span class="count" data-to={value} data-decimals={decimals}>{display}</span>{suffix}</Placeholder>
    ) : (
      <>{prefix}<span class="count" data-to={value} data-decimals={decimals}>{display}</span>{suffix}</>
    )}
  </p>
  <p class="stat-label">{label}</p>
  {source && <p class="stat-source mono muted">Source: {source}</p>}
</div>
<script>
  const counters = document.querySelectorAll<HTMLElement>('.stat .count');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce && 'IntersectionObserver' in window) {
    const fmt = (n: number, d: number) => n.toLocaleString('en-US', { minimumFractionDigits: d, maximumFractionDigits: d });
    const run = (el: HTMLElement) => {
      const to = Number(el.dataset.to), d = Number(el.dataset.decimals || 0), dur = 1200, t0 = performance.now();
      const step = (t: number) => {
        const p = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - p, 3);
        el.textContent = fmt(to * e, d);
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => { if (en.isIntersecting) { io.unobserve(en.target); run(en.target as HTMLElement); } });
    }, { threshold: 0.6 });
    counters.forEach((el) => {
      const r = el.getBoundingClientRect();
      if (r.top < window.innerHeight) return; // already visible on load: leave as-is
      el.textContent = '0';
      io.observe(el);
    });
  }
</script>
<style>
  .stat { border-top: 1px solid var(--ink); padding-top: 16px; }
  .stat-value { font-size: clamp(3rem, 6vw, 5rem); font-weight: 600; line-height: 1; margin: 0 0 12px; }
  .stat-value .ph-tag { font-size: 0.6875rem; letter-spacing: 0.04em; vertical-align: top; }
  .stat-label { max-width: 28ch; margin: 0; }
  .stat-source { margin: 12px 0 0; }
</style>
